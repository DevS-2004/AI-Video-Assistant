# Streamlit Cloud Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your keys.
# On Streamlit Cloud, paste these into the "Secrets" dashboard instead.
#
# DO NOT commit secrets.toml to Git — it is listed in .gitignore

MISTRAL_API_KEY = "your_mistral_api_key_here"
SARVAM_API_KEY  = "your_sarvam_api_key_here"

# Whisper model size: tiny | base | small | medium | large
# Use "tiny" or "base" on Streamlit Cloud free tier (RAM limited)
# Use "small" or "medium" locally for better accuracy
WHISPER_MODEL   = "tiny"
